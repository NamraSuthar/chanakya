# Database
DATABASE_URL=postgresql://user:password@localhost:5432/oidc_auth

# Server
PORT=8000
NODE_ENV=development

# OIDC Configuration
ISSUER_URL=http://localhost:8000

# Admin API Key (for managing clients)
ADMIN_KEY=your-secure-admin-key-here

# JWT/Certificates
# These are read from ./cert/private-key.pem and ./cert/public-key.pub
# Make sure to generate these before deploying
PRIVATE_KEY_PATH=./cert/private-key.pem
PUBLIC_KEY_PATH=./cert/public-key.pub

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: Token Expiration Times (in seconds)
AUTH_CODE_EXPIRES_IN=300
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=604800
